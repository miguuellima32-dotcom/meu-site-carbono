      <button class="btn-auth" onclick="verifyOTP()">Verificar Código</button>
      <button type="button" class="btn-cancel-auth" onclick="fecharAuthModal()">Cancelar</button>
    </div>

    <!-- ETAPA 3: FICHA DE INFORMAÇÕES PESSOAIS (KYC) -->
    <div class="auth-step" id="step-3">
      <h2 style="margin-bottom: 5px;">Informações Pessoais (KYC)</h2>
      <p style="color: var(--gray); font-size: 0.85rem; margin-bottom: 1.5rem;">Preencha seus dados para habilitar sua conta.</p>
      <form onsubmit="finishRegistration(event)">
        <div class="form-group"><label>CPF ou CNPJ</label><input type="text" id="reg-cpf" placeholder="000.000.000-00" required></div>
        <div class="form-group"><label>Telefone / WhatsApp</label><input type="text" id="reg-tel" placeholder="(00) 00000-0000" required></div>
        <div class="form-group">
