<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EcoCarbon | Marketplace de Ativos Sustentáveis e Crédito de Carbono</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <style>
    :root {
      --header-bg: #042f2e;
      --header-text: #ffffff;
      --market-accent: #10b981;
      --primary: #059669;
      --primary-dark: #065f46;
      --dark: #0f172a;
      --light: #f8fafc;
      --gray: #64748b;
      --warning: #f59e0b;
      --danger: #ef4444;
      --success: #10b981;
      --border-radius: 12px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', 'Segoe UI', system-ui, sans-serif; }

    body { background-color: #f1f5f9; color: var(--dark); overflow-x: hidden; }

    /* HEADER PREMIUM */
    header {
      background-color: var(--header-bg);
      padding: 16px 0;
      box-shadow: 0 4px 20px rgba(0,0,0,0.15);
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .header-content { max-width: 1400px; margin: 0 auto; padding: 0 1.5rem; }

    .header-top { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 12px; }

    header h1 { display: flex; align-items: center; gap: 10px; font-size: 1.5rem; color: var(--header-text); letter-spacing: -0.5px; cursor: pointer; }
    header span { color: var(--market-accent); font-weight: 800; }

    .search-bar {
      flex-grow: 1; display: flex; border-radius: 8px; overflow: hidden; background: rgba(255,255,255,0.1);
      max-width: 500px; border: 1px solid rgba(255,255,255,0.2); transition: 0.3s;
    }
    .search-bar:focus-within { background: white; border-color: var(--market-accent); }
    .search-bar input { width: 100%; padding: 10px 15px; border: none; outline: none; background: transparent; color: white; }
    .search-bar:focus-within input { color: var(--dark); }

    .user-menu { display: flex; align-items: center; gap: 15px; font-size: 0.9rem; color: var(--header-text); }
    .user-menu button { background: none; border: none; cursor: pointer; font-weight: 600; color: var(--header-text); transition: 0.2s; }
    .user-menu button:hover { color: var(--market-accent); }

    nav { display: flex; gap: 18px; flex-wrap: wrap; }
    nav button {
      background: none; border: none; color: rgba(255, 255, 255, 0.7);
      font-weight: 600; font-size: 0.9rem; cursor: pointer; padding-bottom: 6px;
      border-bottom: 3px solid transparent; transition: 0.3s;
    }
    nav button.active, nav button:hover { color: white; border-bottom: 3px solid var(--market-accent); }

    /* CONTAINER PRINCIPAL */
    .container { max-width: 1400px; margin: 2rem auto; padding: 0 1.5rem; }
    .page { display: none; }
    .page.active { display: block; animation: fadeIn 0.3s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

    /* CARDS DE PREÇO */
    .grid-prices { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2rem; }
    .card-price {
      background: white; padding: 1.5rem; border-radius: var(--border-radius);
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); border-top: 4px solid var(--market-accent);
    }
    .card-price h3 { font-size: 0.85rem; color: var(--gray); text-transform: uppercase; margin-bottom: 0.5rem; }
    .card-price .price { font-size: 1.8rem; font-weight: 800; color: var(--dark); }

    /* MARKETPLACE & BOXES */
    .olx-box { background: white; padding: 2rem; border-radius: var(--border-radius); margin-bottom: 2rem; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    .btn-sub {
      padding: 0.6rem 1.2rem; font-weight: bold; border: 2px solid var(--market-accent);
      border-radius: 8px; cursor: pointer; margin-right: 8px; transition: 0.2s;
      background: white; color: var(--market-accent);
    }
    .btn-sub.active, .btn-sub:hover { background: var(--market-accent); color: white; }
    .sub-page { display: none; }
    .sub-page.active { display: block; }

    .grid-produtos { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
    .card-anuncio {
      background: white; border-radius: var(--border-radius); overflow: hidden;
      box-shadow: 0 4px 6px rgba(0,0,0,0.05); transition: 0.3s; display: flex; flex-direction: column; border: 1px solid #e2e8f0;
    }
    .card-anuncio:hover { transform: translateY(-4px); box-shadow: 0 10px 20px rgba(0,0,0,0.08); }
    .img-container { width: 100%; height: 180px; background-color: #e2e8f0; position: relative; }
    .img-container img { width: 100%; height: 100%; object-fit: cover; }
    .card-conteudo { padding: 1.2rem; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; }
    .preco { font-size: 1.4rem; color: var(--primary-dark); font-weight: 800; margin-bottom: 0.3rem; }
    .btn-comprar { width: 100%; background: var(--header-bg); color: white; border: none; padding: 10px; border-radius: 8px; font-weight: bold; cursor: pointer; margin-top: 1rem; transition: 0.2s; }
    .btn-comprar:hover { background: var(--primary-dark); }

    /* FILTROS DE CATEGORIA */
    .filter-bar { display: flex; gap: 10px; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .filter-btn { padding: 8px 16px; border-radius: 20px; border: 1px solid #cbd5e1; background: white; cursor: pointer; font-weight: 600; font-size: 0.85rem; color: var(--gray); transition: 0.2s; }
    .filter-btn.active, .filter-btn:hover { background: var(--primary); color: white; border-color: var(--primary); }

    /* CONTA DO USUÁRIO */
    .conta-container { max-width: 900px; margin: 0 auto; background: white; border-radius: var(--border-radius); overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    .conta-header { background: linear-gradient(135deg, var(--header-bg), var(--primary-dark)); color: white; padding: 2.5rem; display: flex; align-items: center; gap: 20px; }
    .conta-avatar { width: 80px; height: 80px; border-radius: 50%; background: white; color: var(--header-bg); display: flex; align-items: center; justify-content: center; font-size: 2.2rem; font-weight: 800; border: 3px solid rgba(255,255,255,0.2); }
    .conta-corpo { padding: 2.5rem; }
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .info-item { border-bottom: 1px solid #f1f5f9; padding-bottom: 0.8rem; }
    .info-item label { font-size: 0.75rem; color: var(--gray); text-transform: uppercase; font-weight: bold; }
    .info-item p { font-size: 0.95rem; color: var(--dark); font-weight: 600; margin-top: 4px; }

    /* TABELA */
    .table-container { background: white; border-radius: var(--border-radius); overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    table { width: 100%; border-collapse: collapse; text-align: left; }
    th, td { padding: 1rem 1.2rem; }
    th { background-color: #e2e8f0; color: var(--dark); font-weight: 600; font-size: 0.9rem; }
    tr:nth-child(even) { background-color: #f8fafc; }
    .rank-badge { display: inline-block; width: 26px; height: 26px; text-align: center; line-height: 26px; border-radius: 50%; font-weight: bold; color: white; background-color: var(--gray); font-size: 0.8rem; }

    /* FORMULÁRIOS */
    .form-section-box { background: white; padding: 2rem; border-radius: var(--border-radius); box-shadow: 0 4px 6px rgba(0,0,0,0.05); margin-top: 1rem; }
    .form-group { margin-bottom: 1.2rem; }
    .form-group label { display: block; font-size: 0.85rem; font-weight: bold; color: var(--dark); margin-bottom: 6px; }
    .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 11px; border: 1.5px solid #e2e8f0; border-radius: 8px; outline: none; transition: 0.2s; font-size: 0.95rem; }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--primary); }

    .btn-auth { width: 100%; padding: 12px; background: var(--primary); color: white; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; margin-top: 0.5rem; transition: 0.2s; }
    .btn-auth:hover { background: var(--primary-dark); }
    .btn-cancel-auth { width: 100%; background: none; border: none; color: var(--gray); margin-top: 8px; cursor: pointer; font-weight: 600; }

    /* MODAL AUTH */
    .modal-auth {
      display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(4px); z-index: 10000;
      justify-content: center; align-items: center; padding: 1.5rem;
    }
    .modal-auth.active { display: flex; }
    .auth-card { background: white; width: 100%; max-width: 420px; border-radius: var(--border-radius); padding: 2rem; box-shadow: 0 20px 50px rgba(0,0,0,0.3); }
    .auth-step { display: none; }
    .auth-step.active { display: block; animation: slideIn 0.3s ease; }
    @keyframes slideIn { from { opacity: 0; transform: translateX(15px); } to { opacity: 1; transform: translateX(0); } }

    .otp-inputs { display: flex; justify-content: center; gap: 10px; margin: 1.2rem 0; }
    .otp-inputs input { width: 45px; height: 55px; text-align: center; font-size: 1.4rem; font-weight: bold; border: 2px solid #e2e8f0; border-radius: 8px; }

    /* CHAT FLUTUANTE */
    .chat-widget {
      display: none; position: fixed; bottom: 25px; right: 25px; width: 340px;
      background: white; border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.15);
      z-index: 1500; flex-direction: column; overflow: hidden; border: 1px solid #e2e8f0;
    }
    .chat-widget.active { display: flex; }
    .chat-header { background: var(--header-bg); color: white; padding: 12px 15px; display: flex; justify-content: space-between; align-items: center; font-size: 0.9rem; font-weight: bold; }

    .toast { position: fixed; bottom: 20px; right: 20px; background: var(--dark); color: white; padding: 10px 20px; border-radius: 8px; display: none; z-index: 11000; box-shadow: 0 5px 15px rgba(0,0,0,0.2); font-size: 0.9rem; }
  </style>
</head>
<body>

<header>
  <div class="header-content">
    <div class="header-top">
      <h1 onclick="switchPage('home')">🌱 Eco<span>Carbon</span></h1>
      <div class="search-bar">
        <input type="text" id="global-search" placeholder="Buscar terras por localização, tamanho ou preço..." oninput="filtrarTerrenosGlobal()">
      </div>
      <div class="user-menu" id="area-usuario"></div>
    </div>
    <nav>
      <button onclick="switchPage('home')" id="nav-home" class="active">Início</button>
      <button onclick="switchPage('terrenos')" id="nav-terrenos">Balcão de Terrenos</button>
      <button onclick="switchPage('dashboard')" id="nav-dashboard">Mercado Global</button>
      <button onclick="switchPage('conta')" id="nav-conta" style="display:none;">Conta</button>
      <button onclick="switchPage('reclame')" id="nav-reclame">Reclame Verde</button>
      <button onclick="switchPage('relatorios')" id="nav-relatorios">Relatórios</button>
      <button onclick="switchPage('calculadora')" id="nav-calculadora">Calculadora ESG</button>
      <button onclick="switchPage('comunidade')" id="nav-comunidade">Comunidade</button>
      <button onclick="switchPage('educacao')" id="nav-educacao">Educação</button>
      <button onclick="switchPage('projetos')" id="nav-projetos">Projetos Sociais</button>
      <button onclick="switchPage('faq')" id="nav-faq">FAQ</button>
      <button onclick="switchPage('suporte')" id="nav-suporte">Suporte</button>
    </nav>
  </div>
</header>

<div class="container">
  
  <!-- 0. PÁGINA INICIAL ESTILO MARKETPLACE -->
  <section id="page-home" class="page active">
    <div style="background: linear-gradient(135deg, var(--header-bg), var(--primary-dark)); color: white; padding: 3rem 2rem; border-radius: var(--border-radius); margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 2rem;">
      <div style="max-width: 650px;">
        <span style="background: var(--market-accent); color: white; padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: bold; text-transform: uppercase;">Bolsa Oficial de Ativos Ambientais</span>
        <h2 style="font-size: 2.2rem; margin: 15px 0 10px 0; letter-spacing: -0.5px;">Negocie Créditos de Carbono e Terras Preservadas com Segurança</h2>
        <p style="opacity: 0.9; font-size: 1rem; line-height: 1.5;">Conectamos investidores corporativos e proprietários rurais em um ecossistema auditado, transparente e de alta liquidez.</p>
        <div style="margin-top: 1.5rem; display: flex; gap: 12px;">
          <button onclick="switchPage('terrenos')" style="background: var(--market-accent); color: white; border: none; padding: 12px 24px; border-radius: 8px; font-weight: bold; cursor: pointer;">Explorar Terrenos</button>
          <button onclick="switchPage('dashboard')" style="background: rgba(255,255,255,0.15); color: white; border: 1px solid rgba(255,255,255,0.3); padding: 12px 24px; border-radius: 8px; font-weight: bold; cursor: pointer;">Ver Cotações Globais</button>
        </div>
      </div>
      <div style="background: rgba(255,255,255,0.1); padding: 1.5rem; border-radius: 12px; backdrop-filter: blur(5px); min-width: 280px; border: 1px solid rgba(255,255,255,0.15);">
        <h4 style="margin-bottom: 10px; font-size: 0.95rem;">Resumo do Mercado Hoje</h4>
        <p style="font-size: 0.85rem; opacity: 0.8; margin-bottom: 6px;">Volume Negociado: <b>14.2 Milhões tCO₂e</b></p>
        <p style="font-size: 0.85rem; opacity: 0.8; margin-bottom: 6px;">Áreas Protegidas: <b>380.000 Hectares</b></p>
        <p style="font-size: 0.85rem; opacity: 0.8;">Índice de Confiabilidade: <b>99.8% Auditado</b></p>
      </div>
    </div>

    <div style="margin-bottom: 2rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.2rem;">
        <h3>Terrenos Recém-Adicionados</h3>
        <button onclick="switchPage('terrenos')" style="background: none; border: none; color: var(--primary); font-weight: bold; cursor: pointer;">Ver Todos &rarr;</button>
      </div>
      <div class="grid-produtos" id="home-recentes"></div>
    </div>
  </section>

  <!-- 1. TERRENOS & BALCÃO -->
  <section id="page-terrenos" class="page">
    <div class="olx-box">
      <h2>Balcão de Negócios e Terras Certificadas</h2>
      <p style="color: var(--gray);">Filtre áreas preservadas e encontre oportunidades alinhadas ao seu perfil de investimento ESG.</p>
      <div style="margin-top: 1.2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
        <div>
          <button id="btn-sub-compre" class="btn-sub active" onclick="switchSub('compre')">🔍 Ver Áreas</button>
          <button id="btn-sub-anuncie" class="btn-sub" onclick="switchSub('anuncie')" style="display: none;">📢 Novo Anúncio</button>
        </div>
      </div>
    </div>

    <div id="sub-compre" class="sub-page active">
      <div class="filter-bar" id="filter-categorias">
        <button class="filter-btn active" onclick="filtrarCategoria('Todas', this)">Todas as Categorias</button>
        <button class="filter-btn" onclick="filtrarCategoria('Amazônia', this)">Florestas Tropicais (Amazônia)</button>
        <button class="filter-btn" onclick="filtrarCategoria('Cerrado', this)">Cerrado e Pastagens</button>
        <button class="filter-btn" onclick="filtrarCategoria('Reflorestamento', this)">Projetos de Reflorestamento</button>
        <button class="filter-btn" onclick="filtrarCategoria('Nascentes', this)">Proteção de Nascentes</button>
      </div>
      <div class="grid-produtos" id="lista-anuncios"></div>
    </div>

    <div id="sub-anuncie" class="sub-page">
      <div class="form-section-box" style="max-width: 650px; margin: 0 auto;">
        <h3>Cadastrar Nova Área no Balcão</h3>
        <form id="form-terreno" onsubmit="salvarAnuncio(event)" style="margin-top: 1.2rem;">
          <div class="form-group"><label>Título do Imóvel / Reserva</label><input type="text" id="tit-anuncio" placeholder="Ex: Reserva Jaguari" required></div>
          <div class="form-group">
            <label>Categoria</label>
            <select id="cat-anuncio">
              <option value="Amazônia">Florestas Tropicais (Amazônia)</option>
              <option value="Cerrado">Cerrado e Pastagens</option>
              <option value="Reflorestamento">Projetos de Reflorestamento</option>
              <option value="Nascentes">Proteção de Nascentes</option>
            </select>
          </div>
          <div class="form-group"><label>Valor Total (R$)</label><input type="text" id="prec-anuncio" placeholder="Ex: 4.500.000" required></div>
          <div class="form-group"><label>Localização (Estado / Região)</label><input type="text" id="loc-anuncio" placeholder="Ex: Mato Grosso - MT" required></div>
          <div class="form-group"><label>Tamanho (Hectares)</label><input type="text" id="tam-anuncio" placeholder="Ex: 1.200 ha" required></div>
          <button type="submit" class="btn-auth">Publicar no Balcão</button>
        </form>
      </div>
    </div>
  </section>

  <!-- 2. CONTA DO USUÁRIO -->
  <section id="page-conta" class="page">
    <div class="conta-container">
      <div class="conta-header">
        <div class="conta-avatar" id="avatar-img">U</div>
        <div>
          <h2 id="conta-nome-user">Nome do Usuário</h2>
          <p id="conta-email-user" style="opacity: 0.8;">email@exemplo.com</p>
          <div style="margin-top: 10px; display: flex; gap: 8px;">
            <span style="background: var(--market-accent); color: white; padding: 4px 10px; border-radius: 20px; font-size: 0.7rem; font-weight: bold;">VERIFICADO ✅</span>
            <span style="background: rgba(255,255,255,0.2); color: white; padding: 4px 10px; border-radius: 20px; font-size: 0.7rem; font-weight: bold;">INVESTIDOR 📈</span>
          </div>
        </div>
      </div>
      <div class="conta-corpo">
        <h3 style="margin-bottom: 1.5rem;">Dados Cadastrais e Conformidade (KYC)</h3>
        <div class="info-grid">
          <div class="info-item"><label>Nome Completo</label><p id="info-nome-full">--</p></div>
          <div class="info-item"><label>E-mail Principal</label><p id="info-email-full">--</p></div>
          <div class="info-item"><label>Documento (CPF/CNPJ)</label><p id="info-cpf">--</p></div>
          <div class="info-item"><label>Telefone / WhatsApp</label><p id="info-tel">--</p></div>
          <div class="info-item"><label>Nível de Acesso</label><p id="info-role">Padrão</p></div>
          <div class="info-item"><label>Membro desde</label><p>Agosto, 2026</p></div>
        </div>
        <button class="btn-auth" style="background: var(--dark); margin-top: 2rem;" onclick="fazerLogout()">Sair da Conta</button>
      </div>
    </div>
  </section>

  <!-- 3. MERCADO GLOBAL & DASHBOARD -->
  <section id="page-dashboard" class="page">
    <div style="margin-bottom: 1.5rem;">
      <h2>Bolsa Global de Carbono e Cotações</h2>
      <p style="color: var(--gray);">Acompanhe o preço à vista dos principais mercados regulados e voluntários do mundo em tempo real.</p>
    </div>
    <div class="grid-prices" id="prices-grid"></div>
    <div class="table-container">
      <table>
        <thead><tr><th>Rank</th><th>Corporação / Fundo</th><th>Setor de Atuação</th><th>Volume Compensado</th><th>Investimento Global</th></tr></thead>
        <tbody id="ranking-table"></tbody>
      </table>
    </div>
  </section>

  <!-- 4. RECLAME VERDE -->
  <section id="page-reclame" class="page">
    <div class="olx-box">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div><h2>Reclame Verde</h2><p style="color: var(--gray);">Fiscalização corporativa independente e combate ativo ao greenwashing.</p></div>
      </div>
      <form onsubmit="enviarReclamacao(event)" style="margin-top: 1.5rem; max-width: 700px;">
        <div class="form-group"><label>Empresa ou Instituição Acusada</label><input type="text" id="rec-empresa" placeholder="Nome corporativo da empresa" required></div>
        <div class="form-group">
          <label>Categoria da Infração</label>
          <select id="rec-categoria">
            <option>Greenwashing em Rótulos / Publicidade</option>
            <option>Falsas Promessas de Neutralidade de Carbono</option>
            <option>Emissões Ocultas na Cadeia de Suprimentos</option>
            <option>Uso de Créditos Duplicados ou Inválidos</option>
          </select>
        </div>
        <div class="form-group"><label>Descrição Detalhada da Irregularidade</label><textarea id="rec-desc" rows="4" placeholder="Descreva os fatos com evidências..." required></textarea></div>
        <button type="submit" class="btn-auth" style="width: auto; padding: 10px 25px;">Registrar Denúncia Oficial</button>
      </form>
    </div>
  </section>

  <!-- 5. RELATÓRIOS -->
  <section id="page-relatorios" class="page">
    <div class="olx-box">
      <h2>Relatórios Oficiais e Laudos de Auditoria (PDF)</h2>
      <p style="color: var(--gray);">Gere e baixe relatórios e laudos em PDF baseados nas denúncias e inventários do sistema.</p>
      
      <div style="margin-top: 2rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        <div style="background: #f8fafc; padding: 1.5rem; border-radius: 8px; border: 1px solid #e2e8f0;">
          <h4>Inventário Anual de Ativos 2025/2026</h4>
          <p style="font-size: 0.85rem; color: var(--gray); margin: 8px 0;">Auditoria completa do volume transacionado na bolsa.</p>
          <button class="btn-auth" style="margin-top: 10px;" onclick="gerarPDFGeral()">Gerar Relatório Geral (PDF)</button>
        </div>
        <div style="background: #f8fafc; padding: 1.5rem; border-radius: 8px; border: 1px solid #e2e8f0;">
          <h4>Boletim de Denúncias (Reclame Verde)</h4>
          <p style="font-size: 0.85rem; color: var(--gray); margin: 8px 0;">Relatório de fiscalização contra greenwashing registrado.</p>
          <button class="btn-auth" style="margin-top: 10px;" onclick="gerarPDFDenuncias()">Gerar Laudo de Denúncias (PDF)</button>
        </div>
      </div>
    </div>
  </section>

