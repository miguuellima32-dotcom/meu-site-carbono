<!-- CHAT FLUTUANTE -->
<div class="chat-widget" id="chat-widget">
  <div class="chat-header">
    <span id="chat-title">Chat EcoCarbon</span>
    <button onclick="closeChat()" style="background:none; border:none; color:white; cursor:pointer; font-size:1rem;">✕</button>
  </div>
  <div style="height: 220px; background: #f8fafc; padding: 12px; overflow-y: auto;" id="chat-msgs">
    <div style="background: white; padding: 8px 12px; border-radius: 8px; margin-bottom: 8px; font-size: 0.85rem; border: 1px solid #e2e8f0;">
      Olá! Como posso ajudar com os detalhes desta área?
    </div>
  </div>
  <div style="padding: 10px; display: flex; gap: 5px; border-top: 1px solid #eee;">
    <input type="text" id="chat-input" placeholder="Mensagem..." style="flex: 1; padding: 8px; border: 1px solid #ddd; border-radius: 5px; outline:none; font-size:0.85rem;" onkeypress="if(event.key==='Enter') sendMsg()">
    <button onclick="sendMsg()" style="background: var(--primary); color: white; border: none; padding: 5px 12px; border-radius: 5px; cursor:pointer; font-size:0.85rem;">Enviar</button>
  </div>
</div>

<div id="toast" class="toast"></div>

<script>
  let usuarioAtual = JSON.parse(localStorage.getItem('ecoMarketUser')) || null;
  let categoriaAtual = 'Todas';

  function toast(msg) {
    const t = document.getElementById("toast");
    t.textContent = msg; t.style.display = "block";
    setTimeout(() => t.style.display = "none", 3000);
  }

  // ATUALIZAÇÃO DA INTERFACE DO MENU DO USUÁRIO
  function atualizarMenuUsuario() {
    const areaUser = document.getElementById('area-usuario');
    const navConta = document.getElementById('nav-conta');
    const btnAnuncie = document.getElementById('btn-sub-anuncie');

    if (usuarioAtual) {
      navConta.style.display = 'inline-block';
      areaUser.innerHTML = `
        <span onclick="switchPage('conta')" style="cursor:pointer">Olá, <b>${usuarioAtual.nome.split(' ')[0]}</b></span>
        <button onclick="fazerLogout()" style="color:#fca5a5; margin-left:10px">Sair</button>
      `;

      document.getElementById('conta-nome-user').textContent = usuarioAtual.nome;
      document.getElementById('conta-email-user').textContent = usuarioAtual.email;
      document.getElementById('info-nome-full').textContent = usuarioAtual.nome;
      document.getElementById('info-email-full').textContent = usuarioAtual.email + " (Verificado via E-mail)";
      document.getElementById('info-cpf').textContent = usuarioAtual.cpf || 'Não informado';
      document.getElementById('info-tel').textContent = usuarioAtual.tel || 'Não informado';
      document.getElementById('avatar-img').textContent = usuarioAtual.nome.charAt(0).toUpperCase();

      if (usuarioAtual.email === 'admin@ecomarket.com' || true) {
        btnAnuncie.style.display = 'inline-block';
        document.getElementById('info-role').textContent = 'Investidor / Proprietário Verificado';
      }
    } else {
      navConta.style.display = 'none';
      btnAnuncie.style.display = 'none';
      areaUser.innerHTML = `
        <button onclick="abrirAuthModal(1)">Entrar / Cadastrar</button>
      `;
      if (document.getElementById('page-conta').classList.contains('active')) {
        switchPage('home');
      }
    }
  }

  // FLUXO DO MODAL DE CADASTRO EM ETAPAS
  function abrirAuthModal(step) {
    document.getElementById('modal-auth').classList.add('active');
    document.querySelectorAll('.auth-step').forEach(s => s.classList.remove('active'));
    document.getElementById(`step-${step}`).classList.add('active');
  }

  function fecharAuthModal() {
    document.getElementById('modal-auth').classList.remove('active');
  }

  function nextStep(e, step) {
    e.preventDefault();
    if (step === 2) {
      const nome = document.getElementById('reg-nome').value;
      const email = document.getElementById('reg-email').value;
      const pass = document.getElementById('reg-pass').value;
      window._tempUser = { nome, email, pass };
      toast("Código de verificação enviado para o e-mail!");
    }
    abrirAuthModal(step);
  }

  function verifyOTP() {
    const code = document.getElementById('otp1').value + document.getElementById('otp2').value + document.getElementById('otp3').value + document.getElementById('otp4').value;
    if (code === "1234") {
      toast("E-mail verificado com sucesso!");
      abrirAuthModal(3);
    } else {
      toast("Código incorreto! Digite 1234.");
    }
  }

  function finishRegistration(e) {
    e.preventDefault();
    const cpf = document.getElementById('reg-cpf').value;
    const tel = document.getElementById('reg-tel').value;

    usuarioAtual = {
      ...window._tempUser,
      cpf,
      tel
    };

    localStorage.setItem('ecoMarketUser', JSON.stringify(usuarioAtual));
    fecharAuthModal();
    toast("Conta criada com sucesso!");
    atualizarMenuUsuario();
    switchPage('conta');
  }

  function fazerLogout() {
    usuarioAtual = null;
    localStorage.removeItem('ecoMarketUser');
    toast("Você saiu da conta.");
    atualizarMenuUsuario();
    switchPage('home');
  }

  // NAVEGAÇÃO DE PÁGINAS
  function switchPage(pageId) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('nav button').forEach(b => b.classList.remove('active'));
    document.getElementById(`page-${pageId}`).classList.add('active');
    const btnNav = document.getElementById(`nav-${pageId}`);
    if (btnNav) btnNav.classList.add('active');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function switchSub(subId) {
    document.querySelectorAll('.sub-page').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.btn-sub').forEach(b => b.classList.remove('active'));
    document.getElementById(`sub-${subId}`).classList.add('active');
    document.getElementById(`btn-sub-${subId}`).classList.add('active');
  }

  // CHAT FLUTUANTE
  function openChat(prop) {
    document.getElementById('chat-title').textContent = "Negociar: " + prop;
    document.getElementById('chat-widget').classList.add('active');
  }
  function closeChat() { document.getElementById('chat-widget').classList.remove('active'); }
  function sendMsg() {
    const input = document.getElementById('chat-input');
    if(!input.value) return;
    const box = document.getElementById('chat-msgs');
    box.innerHTML += `<div style="background: var(--market-accent); color: white; padding: 8px 12px; border-radius: 8px; margin-bottom: 8px; font-size: 0.85rem; align-self: flex-end; margin-left: 20%;">${input.value}</div>`;
    input.value = "";
    box.scrollTop = box.scrollHeight;

    setTimeout(() => {
      box.innerHTML += `<div style="background: white; padding: 8px 12px; border-radius: 8px; margin-bottom: 8px; font-size: 0.85rem; border: 1px solid #e2e8f0;">Mensagem recebida! O corretor responsável entrará em contato em breve.</div>`;
      box.scrollTop = box.scrollHeight;
    }, 1000);
  }

  // DADOS DE IMÓVEIS (TERRENOS)
  let imoveis = [
    { id: 1, tit: "Reserva Jaguari", cat: "Amazônia", val: "R$ 4.500.000", loc: "Mato Grosso - MT", tam: "1.200 ha", img: "https://images.unsplash.com/photo-1516026672322-bc52d61a55d5?auto=format&fit=crop&w=500" },
    { id: 2, tit: "Fazenda Carbono Zero", cat: "Cerrado", val: "R$ 2.100.000", loc: "Goiás - GO", tam: "500 ha", img: "https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=500" },
    { id: 3, tit: "Reserva Legal com Nascentes", cat: "Nascentes", val: "R$ 3.750.000", loc: "Chapada Diamantina - BA", tam: "680 ha", img: "https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=500" },
    { id: 4, tit: "Vale Verde Sustentável", cat: "Reflorestamento", val: "R$ 1.850.000", loc: "Paraná - PR", tam: "320 ha", img: "https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=500" }
  ];

  function renderizarListaImoveis(filtroCat = 'Todas', termoBusca = '') {
    const grid = document.getElementById('lista-anuncios');
    const gridHome = document.getElementById('home-recentes');

    let filtrados = imoveis.filter(i => {
      const matchCat = (filtroCat === 'Todas' || i.cat === filtroCat);
      const matchTermo = i.tit.toLowerCase().includes(termoBusca.toLowerCase()) || 
                         i.loc.toLowerCase().includes(termoBusca.toLowerCase()) || 
                         i.val.toLowerCase().includes(termoBusca.toLowerCase());
      return matchCat && matchTermo;
    });

    const htmlCards = filtrados.map(i => `
      <div class="card-anuncio">
        <div class="img-container"><img src="${i.img}" alt="Terreno"></div>
        <div class="card-conteudo">
          <div>
            <span style="background: #e6f4ea; color: var(--primary-dark); padding: 3px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: bold;">${i.cat}</span>
            <div class="preco" style="margin-top: 6px;">${i.val}</div>
            <h4 style="font-size: 0.95rem; margin-bottom: 4px;">${i.tit}</h4>
            <p style="color: var(--gray); font-size: 0.8rem; margin-bottom: 0.5rem;">📍 ${i.loc} • 📏 ${i.tam}</p>
          </div>
          <button class="btn-comprar" onclick="openChat('${i.tit}')">Negociar com Vendedor</button>
        </div>
      </div>
    `).join('');

    if (grid) grid.innerHTML = htmlCards || '<p style="color: var(--gray);">Nenhum terreno encontrado com estes critérios.</p>';
    if (gridHome) {
      gridHome.innerHTML = imoveis.slice(0, 3).map(i => `
        <div class="card-anuncio">
          <div class="img-container"><img src="${i.img}" alt="Terreno"></div>
          <div class="card-conteudo">
            <div>
              <span style="background: #e6f4ea; color: var(--primary-dark); padding: 3px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: bold;">${i.cat}</span>
              <div class="preco" style="margin-top: 6px;">${i.val}</div>
              <h4 style="font-size: 0.95rem; margin-bottom: 4px;">${i.tit}</h4>
              <p style="color: var(--gray); font-size: 0.8rem; margin-bottom: 0.5rem;">📍 ${i.loc} • 📏 ${i.tam}</p>
            </div>
            <button class="btn-comprar" onclick="openChat('${i.tit}')">Negociar com Vendedor</button>
          </div>
        </div>
      `).join('');
    }
  }

  function filtrarCategoria(cat, btn) {
    categoriaAtual = cat;
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    renderizarListaImoveis(categoriaAtual, document.getElementById('global-search').value);
  }

  // ALGORITMO DE BUSCA GLOBAL INTELIGENTE
  function filtrarTerrenosGlobal() {
    const termo = document.getElementById('global-search').value;
    renderizarListaImoveis(categoriaAtual, termo);
  }

  function salvarAnuncio(e) {
    e.preventDefault();
    const tit = document.getElementById('tit-anuncio').value;
    const cat = document.getElementById('cat-anuncio').value;
    const val = document.getElementById('prec-anuncio').value;
    const loc = document.getElementById('loc-anuncio').value;
    const tam = document.getElementById('tam-anuncio').value;

    imoveis.unshift({ id: Date.now(), tit, cat, val: `R$ ${val}`, loc, tam, img: "https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=500" });
    renderizarListaImoveis();
    document.getElementById('form-terreno').reset();
    switchSub('compre');
    toast("Novo terreno publicado com sucesso no balcão!");
  }

  // COTAÇÕES DO MERCADO GLOBAL
  function updatePrices() {
    const p = { eu: (76.20 + Math.random()*1.5).toFixed(2), us: (43.10 + Math.random()*1.2).toFixed(2), vol: (9.80 + Math.random()*0.4).toFixed(2) };
    const now = new Date().toLocaleTimeString('pt-BR');
    const pricesGrid = document.getElementById('prices-grid');
    if (pricesGrid) {
      pricesGrid.innerHTML = `
        <div class="card-price"><h3>Crédito EU-ETS (Europa)</h3><div class="price">€ ${p.eu}</div><p style="font-size:0.75rem; color:var(--primary); margin-top:5px;">Atualizado às ${now}</p></div>
        <div class="card-price"><h3>Califórnia CCA (EUA)</h3><div class="price">US$ ${p.us}</div><p style="font-size:0.75rem; color:var(--primary); margin-top:5px;">Atualizado às ${now}</p></div>
        <div class="card-price"><h3>Voluntário VCM (Global)</h3><div class="price">US$ ${p.vol}</div><p style="font-size:0.75rem; color:var(--gray); margin-top:5px;">Atualizado às ${now}</p></div>
      `;
    }
  }

  const ranking = [
    { name: "Global Tech Inc. (Fundo Verde)", sector: "Tecnologia / Data Centers", vol: "4.500.000 tCO₂e", inv: "US$ 67.5M" },
    { name: "Euro Airways Holding", sector: "Aviação Comercial", vol: "3.800.000 tCO₂e", inv: "US$ 57.0M" },
    { name: "Trans-Pacific Logistics Corp.", sector: "Marítimo / Transportes", vol: "2.900.000 tCO₂e", inv: "US$ 43.5M" },
    { name: "Amazonia Green Capital", sector: "Fundo de Investimento Rural", vol: "2.100.000 tCO₂e", inv: "US$ 31.5M" },
    { name: "Nordic Energy Transition", sector: "Energia e Petróleo", vol: "1.750.000 tCO₂e", inv: "US$ 26.2M" }
  ];

  function renderRanking() {
    const tbody = document.getElementById('ranking-table');
    if (tbody) {
      tbody.innerHTML = ranking.map((r, i) => `
        <tr>
          <td><span class="rank-badge">${i+1}</span></td>
          <td><strong>${r.name}</strong></td>
          <td>${r.sector}</td>
          <td>${r.vol}</td>
          <td>${r.inv}</td>
        </tr>
      `).join('');
    }
  }

  // RECLAME VERDE E LISTA DE DENÚNCIAS
  let listaDenuncias = [
    { empresa: "EcoLog Indústria Ltda", cat: "Falsas Promessas de Neutralidade de Carbono", desc: "Divulgou neutralidade sem auditoria de escopo 3.", data: "15/08/2026" },
    { empresa: "Global Foods S.A.", cat: "Greenwashing em Rótulos / Publicidade", desc: "Uso de selo verde não reconhecido por registradores internacionais.", data: "16/08/2026" }
  ];

  function enviarReclamacao(e) {
    e.preventDefault();
    const empresa = document.getElementById('rec-empresa').value;
    const cat = document.getElementById('rec-categoria').value;
    const desc = document.getElementById('rec-desc').value;
    
    listaDenuncias.unshift({ empresa, cat, desc, data: new Date().toLocaleDateString('pt-BR') });
    toast("Denúncia registrada com sucesso na auditoria pública!");
    e.target.reset();
  }

  // GERADOR DE PDF COM JSPDF
  function gerarPDFGeral() {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();
    
    doc.setFont("helvetica", "bold");
    doc.setFontSize(18);
    doc.text("EcoCarbon - Relatório Geral de Ativos e Mercado", 20, 20);
    
    doc.setFont("helvetica", "normal");
    doc.setFontSize(11);
    doc.text("Data de Emissão: " + new Date().toLocaleDateString('pt-BR'), 20, 30);
    doc.text("Volume Total Transacionado: 14.2 Milhões tCO2e", 20, 40);
    doc.text("Áreas Protegidas Cadastradas: 380.000 Hectares", 20, 50);
    doc.text("Status de Auditoria: 99.8% de Conformidade Verificada", 20, 60);

    doc.save("EcoCarbon_Relatorio_Geral.pdf");
    toast("Relatório Geral em PDF gerado com sucesso!");
  }

  function gerarPDFDenuncias() {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();
    
    doc.setFont("helvetica", "bold");
    doc.setFontSize(18);
    doc.text("EcoCarbon - Laudo Oficial de Denúncias (Reclame Verde)", 20, 20);
    
    doc.setFont("helvetica", "normal");
    doc.setFontSize(11);
    doc.text("Data de Emissão: " + new Date().toLocaleDateString('pt-BR'), 20, 30);
    
    let y = 45;
    listaDenuncias.forEach((d, index) => {
      doc.setFont("helvetica", "bold");
      doc.text(`${index + 1}. Empresa: ${d.empresa}`, 20, y);
      doc.setFont("helvetica", "normal");
      doc.text(`Categoria: ${d.cat}`, 25, y + 7);
      doc.text(`Descrição: ${d.desc}`, 25, y + 14);
      doc.text(`Data: ${d.data}`, 25, y + 21);
      y += 32;
    });

    doc.save("EcoCarbon_Laudo_Denuncias.pdf");
    toast("Laudo de Denúncias em PDF gerado com sucesso!");
  }

  // CALCULADORA DE CRÉDITO DE CARBONO PRECISA
  function calcularCreditoCarbono(e) {
    e.preventDefault();
    const setor = document.getElementById('calc-setor').value;
    const faturamento = parseFloat(document.getElementById('calc-faturamento').value) || 0;
    const func = parseFloat(document.getElementById('calc-func').value) || 0;

    let fatorEmissao = 0.00015;
    if (setor === 'industria') fatorEmissao = 0.00035;
    if (setor === 'transporte') fatorEmissao = 0.00028;
    if (setor === 'agro') fatorEmissao = 0.00040;

    const tco2e = (faturamento * fatorEmissao) + (func * 1.8);
    const precoMedioCredito = 55;
    const custoTotal = tco2e * precoMedioCredito;

    document.getElementById('calc-resultado').innerHTML = `
      <b>Resultado da Análise de Crédito de Carbono:</b><br>
      • Emissão Estimada: <b>${tco2e.toFixed(2)} tCO₂e/ano</b><br>
      • Créditos Necessários para Neutralização: <b>${Math.ceil(tco2e)} créditos</b><br>
      • Investimento Estimado para Neutralização: <b>R$ ${custoTotal.toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</b>
    `;
  }

  function enviarSuporte(e) {
    e.preventDefault();
    toast("Chamado técnico enviado com sucesso! Retornaremos em breve.");
    e.target.reset();
  }

  window.onload = () => {
    atualizarMenuUsuario();
    renderizarListaImoveis();
    updatePrices();
    renderRanking();
    setInterval(updatePrices, 6000);
  };
</script>
